// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "ssh_connections": [
    {
      "host": "127.0.0.1",
      "port": 52617,
      "args": [
        "-i",
        "~/.lima/_config/user",
        "-A"
      ],
      "projects": [
        {
          "paths": [
            "/home/ganesh.guest/1brc/./"
          ]
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "username": "laborant",
      "port": 47496,
      "args": [
        "-i",
        "/Users/ganesh/.ssh/iximiuz_labs_user",
        "-A"
      ],
      "projects": [
        {
          "paths": [
            "/home/laborant"
          ]
        },
        {
          "paths": [
            "/home/laborant/aicr/./"
          ]
        }
      ]
    },
    {
      "host": "127.0.0.1",
      "username": "laborant",
      "port": 58904,
      "args": [
        "-i",
        "/Users/ganesh/.ssh/iximiuz_labs_user"
      ],
      "projects": [
        {
          "paths": []
        },
        {
          "paths": [
            "/home/laborant/./"
          ]
        },
        {
          "paths": [
            "/home/laborant/services/./"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "tab_size": 2,
  "preferred_line_length": 80,
  "soft_wrap": "bounded",
  "show_wrap_guides": true,
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Ayu Dark",
  },
}
